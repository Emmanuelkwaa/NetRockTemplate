# Production settings for docker-compose.yaml.
# Copy to .env (git-ignored) and fill in every value. Never commit .env.

# Public URL users reach the app on (used for CORS, email links and the frontend origin)
PUBLIC_URL=https://your-production-domain.com
# Host port to publish
HTTP_PORT=
# Set to false only when testing over plain HTTP without a TLS-terminating proxy
Hosting__ForceHttps=true

# @init:if database=managed
# PostgreSQL (runs in the compose stack)
POSTGRES_DB=net-rock-template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Applies EF Core migrations when the API starts
Database__MigrateOnStartup=true
# @init:else
# PostgreSQL (external). The database needs the pg_trgm extension - see docs/deployment.md.
ConnectionStrings__Database=Host=db.example.com;Port=5432;Database=net-rock-template;Username=app;Password=
# Migrations do not run automatically against an external database by default
Database__MigrateOnStartup=false
# @init:end

# @init:if auth=jwt
# Authentication (generate with: openssl rand -base64 48)
Authentication__Jwt__Key=
Authentication__ExternalProviders__EncryptionKey=
Captcha__SecretKey=
# Optional superuser created on first start
Seed__Users__0__Email=
Seed__Users__0__Password=
# @init:end
# @init:if auth=keycloak
# Keycloak (see docs/keycloak.md)
Authentication__Keycloak__Authority=https://auth.example.com/realms/my-realm
Authentication__Keycloak__ClientId=
Authentication__Keycloak__ClientSecret=
# @init:end

# File storage (external S3-compatible service)
FileStorage__Endpoint=https://s3.example.com
FileStorage__AccessKey=
FileStorage__SecretKey=
FileStorage__BucketName=net-rock-template-files
FileStorage__UseSSL=true

# Email (SMTP)
Email__Enabled=false
Email__FromAddress=noreply@example.com
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__UseSsl=true
# @init:if frontend=yes auth=jwt

# Cloudflare Turnstile site key (public)
TURNSTILE_SITE_KEY=
# @init:end
